# Copy to .env and fill in. Never commit the real .env (it is gitignored).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/insurance_claims?retryWrites=true&w=majority

# Must be set when NODE_ENV=production; the app refuses to boot without it.
JWT_SECRET=replace-with-a-long-random-string

# Canonical ports:
#   5000  backend API (also the container port)
#   5173  Vite dev server (local)
#   3000  frontend container (nginx)
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins for CORS.
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Where the Vite dev server proxies /api. Must match PORT above.
VITE_API_TARGET=http://localhost:5000
